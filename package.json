{
  "name": "homebridge-deye-inverter",
  "displayName": "Deye Inverter",
  "version": "1.0.3",
  "description": "Deye inverter temperatures, grid, storage battery and electrical power/current/voltage via Homebridge Matter",
  "main": "dist/index.js",
  "keywords": [
    "homebridge-plugin",
    "deye",
    "modbus",
    "temperature"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": ">=2.2.0 <3.0.0"
  },
  "files": [
    "dist/**/*.js",
    "config.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "serve": "node dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:matter": "npm run build && node --test test/matter.integration.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "homebridge": "^2.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
